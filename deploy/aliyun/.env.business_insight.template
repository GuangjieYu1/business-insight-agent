# Copy this file to /srv/business-insight-agent/.env before deployment.
# The docker compose file reads .env from the repository root.

# Compose-level deployment metadata.
BIA_IMAGE_TAG=local
BIA_HOST_DATA_DIR=/srv/business-insight-agent/data

# Fixed Business Insight runtime mode.
APP_PRODUCT_MODE=business_insight
SANDBOX=local
WORKSPACE_BACKEND=local
DATA_FORMULATOR_HOME=/srv/business-insight-agent/data
DISABLE_DISPLAY_KEYS=true
DISABLE_DATA_CONNECTORS=true
DISABLE_CUSTOM_MODELS=true
AVAILABLE_LANGUAGES=en,zh

# Must be generated once and kept stable across restarts and migrations.
# Example:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-stable-secret

# Business Insight keeps remote analysis receivers disabled by default.
# Enable only through administrator-owned JSON after policy review.
BIA_REMOTE_ANALYSIS_SERVICES=[]

# Enable one or more server-configured model providers below.
# Leave unused providers disabled.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.4

AZURE_ENABLED=false
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_MODELS=gpt-5.4

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-4-20250514

OLLAMA_ENABLED=false
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODELS=qwen3:32b
